{
  "name": "computational-total-war",
  "version": "0.1.0",
  "private": true,
  "description": "Machine-readable Total War: Warhammer III context for AI agents, with reproducible datasets and validation scripts.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "npm run validate:units && npm run validate:skills && npm run validate:economy && npm run validate:campaign && npm run validate:technologies && npm run validate:guides && npm run test:victory && npm run test:readme && npm run test:battle-maps",
    "validate:units": "node scripts/validate-unit-dataset.mjs data/unit_stats/source_exports data/unit_stats && node --test scripts/test-lord-unit-coverage.mjs scripts/test-availability-coverage.mjs scripts/test-historical-roster-coverage.mjs",
    "validate:skills": "node scripts/validate-skill-trees.mjs data/skill_trees/source_exports data/skill_trees",
    "validate:economy": "node scripts/validate-economy-dataset.mjs data/economy/source_exports data/economy",
    "validate:campaign": "node scripts/validate-campaign-atlas.mjs data/campaign_map/campaign_atlas__wh3__9.0.gpkg data/campaign_map",
    "validate:guides": "node scripts/faction-guide-queue.mjs validate-all",
    "extract:technologies": "node scripts/extract-technology-source.mjs",
    "build:technologies": "node scripts/build-technology-trees.mjs",
    "validate:technologies": "node scripts/validate-technology-trees.mjs data/technology_trees/source_exports data/technology_trees",
    "test:technologies": "node scripts/test-technology-trees.mjs",
    "verify:technology-extraction": "node scripts/verify-technology-extraction.mjs",
    "test:validation-text": "node scripts/test-validation-text.mjs",
    "audit:effect-foundation": "node scripts/audit-effect-foundation.mjs",
    "extract:effect-source": "powershell.exe -NoProfile -File scripts/extract-effect-source.ps1",
    "validate:effect-source": "node scripts/validate-effect-source.mjs",
    "test:effect-foundation": "node --test scripts/test-effect-foundation.mjs",
    "test:campaign-starts": "python3 scripts/test_campaign_starts.py",
    "test:snapshot": "node --test scripts/test-snapshot.mjs",
    "test:victory": "node --test scripts/test-victory-config.mjs",
    "test:readme": "node --test scripts/test-generated-readmes.mjs",
    "test:battle-maps": "node --test scripts/test-battle-map-coverage.mjs"
  },
  "license": "MIT"
}
